# Frontend Environment Variables
# Copy this file to .env.local and fill in your values

# Backend API URL
# Development: http://localhost:8000
# Production: https://your-backend-domain.com
VITE_API_BASE_URL=https://farmlens-pts8.onrender.com

# App Configuration
VITE_APP_NAME=FarmLens
VITE_APP_VERSION=1.0.0

# Monitoring: Sentry Error Tracking
# Get DSN from: https://sentry.io/settings/projects/your-project/keys/
# Leave empty to disable error tracking
VITE_SENTRY_DSN=

# Instructions:
# 1. Copy this file: cp .env.example .env.local
# 2. Update VITE_API_BASE_URL with your production backend URL
# 3. (Optional) Add VITE_SENTRY_DSN for error tracking
# 4. Never commit .env.local to version control
